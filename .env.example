# Copie ce fichier en ".env" (même dossier que manage.py) et remplis-le.
# Le fichier .env contient des secrets : il est ignoré par Git, ne le partage jamais.

# Adresse admin de la boutique, sans https:// (ex. kilometre-paris ou kilometre-paris.myshopify.com)
SHOPIFY_SHOP=

# Méthode actuelle : app créée dans le Dev Dashboard de Shopify (Settings > Client ID / Client secret)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# OU ancienne app personnalisée (créée avant 2026) : jeton qui commence par shpat_
# SHOPIFY_ACCESS_TOKEN=
